<?xml version="1.0"?>
<robot name="cr7as_grasp">
  <!-- Connect MoveIt's base_link to the Gazebo/RViz world frame. -->
  <virtual_joint name="world_joint" type="fixed" parent_frame="world" child_link="base_link" />

  <group name="ARM">
    <chain base_link="b0" tip_link="grasp_tcp" />
  </group>

  <group_state name="home" group="ARM">
    <joint name="j1" value="1.57" />
    <joint name="j2" value="0.0" />
    <joint name="j3" value="0.0" />
    <joint name="j4" value="0.0" />
    <joint name="j5" value="-1.57" />
    <joint name="j6" value="0.0" />
  </group_state>

  <group_state name="zero" group="ARM">
    <joint name="j1" value="0.0" />
    <joint name="j2" value="0.0" />
    <joint name="j3" value="0.0" />
    <joint name="j4" value="0.0" />
    <joint name="j5" value="0.0" />
    <joint name="j6" value="0.0" />
  </group_state>

  <!-- Adjacent links are fixed together and must not be treated as self-collisions. -->
  <disable_collisions link1="b0" link2="l1" reason="Adjacent" />
  <disable_collisions link1="l1" link2="l2" reason="Adjacent" />
  <disable_collisions link1="l2" link2="l3" reason="Adjacent" />
  <disable_collisions link1="l3" link2="l4" reason="Adjacent" />
  <disable_collisions link1="l4" link2="l5" reason="Adjacent" />
  <disable_collisions link1="l5" link2="l6" reason="Adjacent" />
  <disable_collisions link1="l6" link2="gripper_base" reason="Adjacent" />
  <disable_collisions link1="b0" link2="l2" reason="Never" />
  <disable_collisions link1="b0" link2="l3" reason="Never" />
  <disable_collisions link1="b0" link2="l4" reason="Never" />
  <disable_collisions link1="b0" link2="l5" reason="Never" />
  <disable_collisions link1="b0" link2="l6" reason="Never" />
  <disable_collisions link1="l1" link2="l3" reason="Never" />
  <disable_collisions link1="l1" link2="l4" reason="Never" />
  <disable_collisions link1="l1" link2="l5" reason="Never" />
  <disable_collisions link1="l1" link2="l6" reason="Never" />
  <disable_collisions link1="l2" link2="l4" reason="Never" />
  <disable_collisions link1="l2" link2="l5" reason="Never" />
  <disable_collisions link1="l2" link2="l6" reason="Never" />
  <disable_collisions link1="l3" link2="l5" reason="Never" />
  <disable_collisions link1="l3" link2="l6" reason="Never" />
  <disable_collisions link1="l4" link2="l6" reason="Never" />
</robot>

