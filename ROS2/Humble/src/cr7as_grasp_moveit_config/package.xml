<?xml version="1.0"?>
<package format="3">
  <name>cr7as_grasp_moveit_config</name>
  <version>0.1.0</version>
  <description>MoveIt 2 Humble configuration for the CR7AS arm with fixed gripper and grasp_tcp.</description>
  <maintainer email="lxq@example.com">lxq</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>cr7as_grasp</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_ros_visualization</exec_depend>
  <exec_depend>moveit_kinematics</exec_depend>
  <exec_depend>moveit_simple_controller_manager</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
